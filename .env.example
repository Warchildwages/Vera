# Vera — Agent Trust Authority
# Copy to .env and fill in your values

NEXT_PUBLIC_APP_URL=http://localhost:3006

# Vera's Ed25519 keypair
VERA_PRIVATE_KEY=
VERA_PUBLIC_KEY=

# Casper Network
CASPER_RPC_URL=https://rpc.testnet.casperlabs.io
CASPER_CHAIN_NAME=casper-testnet

# MCP Discovery
MCP_REGISTRY_URL=https://mcp.casper.network/registry

# Mock mode — true returns seed data, no external calls needed
VERA_MOCK_MODE=true
