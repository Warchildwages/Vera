# Vera — Agent Trust Authority
# Copy to .env and fill in your values

NEXT_PUBLIC_APP_URL=http://localhost:3006

# Vera's Ed25519 keypair — for signing attestations
# Generate: casper-client keygen ./vera-attest-keys
# VERA_ATTEST_PUBLIC_KEY=
# VERA_ATTEST_SECRET_KEY=

# AgentAttest contract hash on Casper Testnet (set after odra deploy)
# VERA_AGENT_ATTEST_CONTRACT=

# Casper Network
CASPER_RPC_URL=https://rpc.testnet.casper.network
CASPER_CHAIN_NAME=casper-testnet

# MCP Discovery
MCP_REGISTRY_URL=https://mcp.casper.network/registry

# Mock mode — true returns seed data, no external calls needed
VERA_MOCK_MODE=true

# Cross-references to known agents (set when deployed)
# LUNA_DID_NOSTR=https://luna-agent.onrender.com/.well-known/did/nostr/luna-pubkey.json
# SIGIL_DID_NOSTR=https://sigil.onrender.com/.well-known/did/nostr/sigil-pubkey.json
# VERA_BASE_URL=http://localhost:3006
